// Used when this repo is deployed as a Cloudflare Worker (Workers Builds).
// Cloudflare Pages ignores this file and uses public/ + functions/ instead.
{
  "name": "leaps-startegy-checker",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Start the stock scan on time, in UTC: 15:00 (11 am EDT / 10 am EST) and 23:00 (7 pm EDT / 6 pm EST), weekdays.
  "triggers": { "crons": ["0 15 * * 1-5", "0 23 * * 1-5"] }
}
